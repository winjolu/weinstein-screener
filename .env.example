# App Key/Secret come from registering an application in Webull's developer
# portal (developer.webull.com), not your regular login. I registered this
# project there as "weinsteinScreener" — Webull's naming rules don't allow
# hyphens, so that's the camelCase form of this project's name.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=

# Sharadar, via Nasdaq Data Link. On trial to answer one question: how
# much has survivorship bias been inflating every result, given Webull
# serves no delisted names at all. The key is the Nasdaq Data Link API
# key from the account that holds the Sharadar subscription.
NASDAQ_DATA_LINK_API_KEY=

# SEC EDGAR refuses requests without a User-Agent naming a contact
# address. Used to resolve which company actually owns a ticker, since
# tickers get recycled and bars predating the current owner belong to
# somebody else. Format: "project-name your@email".
SEC_USER_AGENT=
